<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:padding="28dp">

    <!-- 아이콘 + 타이틀 -->
    <TextView
        android:id="@+id/tv_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="⚡ 챌린지 모드"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#FF6F61"
        android:layout_marginBottom="16dp"/>

    <!-- 구분선 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#FFDDDD"
        android:layout_marginBottom="16dp"/>

    <!-- 안내 메시지 -->
    <TextView
        android:id="@+id/tv_dialog_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🏆 이 모드는 순수 실력 측정용이에요!\n\n정답 힌트 없이 진행되며, 여러분의 진짜 어휘력을 기록합니다.\n\n준비가 되셨나요? 🔥"
        android:textSize="15sp"
        android:textColor="#444444"
        android:lineSpacingMultiplier="1.4"
        android:layout_marginBottom="24dp"/>

    <!-- 버튼 행 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_dialog_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="아니오"
            android:textSize="15sp"
            android:textColor="#888888"
            android:background="@drawable/bg_btn_dialog_cancel"
            android:stateListAnimator="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>

        <Button
            android:id="@+id/btn_dialog_confirm"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="도전! 🔥"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_dialog_confirm"
            android:stateListAnimator="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>
    </LinearLayout>

</LinearLayout>
