<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:padding="24dp">

    <!-- 타이틀 -->
    <TextView
        android:id="@+id/tv_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🏆 랭킹 등록"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1E293B"
        android:gravity="center"
        android:layout_marginBottom="8dp"/>

    <!-- 점수 표시 -->
    <TextView
        android:id="@+id/tv_dialog_score"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="최종 점수: 0점"
        android:textSize="16sp"
        android:textColor="#5211D4"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <!-- 닉네임 입력 -->
    <EditText
        android:id="@+id/et_nickname"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="닉네임 입력 (최대 8자)"
        android:maxLength="8"
        android:textSize="15sp"
        android:paddingHorizontal="16dp"
        android:background="@drawable/bg_input_field"
        android:inputType="text"
        android:singleLine="true"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tv_dialog_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📺 광고 시청 후 랭킹에 등록됩니다"
        android:textSize="12sp"
        android:textColor="#94A3B8"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <!-- 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_dialog_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="취소"
            android:textColor="#64748B"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_dialog_cancel"
            android:layout_marginEnd="8dp"
            android:stateListAnimator="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>

        <Button
            android:id="@+id/btn_dialog_register"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="등록하기"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_dialog_confirm"
            android:layout_marginStart="8dp"
            android:stateListAnimator="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>
    </LinearLayout>

</LinearLayout>
